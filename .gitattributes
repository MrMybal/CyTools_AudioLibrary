# Text is stored with LF in the repository, whatever the editor wrote on Windows.
* text=auto eol=lf

# Windows command scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touched by line-ending conversion.
*.png binary
*.ico binary
*.exe binary
*.whl binary
*.zip binary
.github export-ignore

# Distribute the complete generated manual, never its private build workspace.
app/.CyDocBuild export-ignore
app/.CyDocExport export-ignore
app/.CyDocExport.previous export-ignore
