// Version information and manifest of CyTools_AudioLibrary.exe.
// launcher.version.h and the manifest are generated by build_launcher.ps1 from app/release.json,
// so the version shown in the file properties is always the version of the application.
#include <windows.h>
#include "launcher.version.h"

1 ICON "assets/branding/logo.ico"

1 RT_MANIFEST "launcher.generated.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     LAUNCHER_VERSION_BINARY
 PRODUCTVERSION  LAUNCHER_VERSION_BINARY
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Cyberalien"
            VALUE "FileDescription",  "CyTools AudioLibrary"
            VALUE "FileVersion",      LAUNCHER_VERSION_TEXT
            VALUE "InternalName",     "CyTools_AudioLibrary"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Cyberalien. Licensed under GPL-3.0-only."
            VALUE "OriginalFilename", "CyTools_AudioLibrary.exe"
            VALUE "ProductName",      "CyTools AudioLibrary"
            VALUE "ProductVersion",   LAUNCHER_VERSION_TEXT
            VALUE "Comments",         "Opens the application with its private Python runtime. Source: app/launcher.cpp, https://github.com/MrMybal/CyTools_AudioLibrary"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
